<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Deterministic restore: only nuget.org plus the local MPCoreDeveloper RC feed.

    The `mpcore-rc` feed holds the net11 RC .nupkg files produced from the sibling
    source repositories (SharpCoreDB, SharpDispatch, SharpPortico, posseth.global.ulid)
    before those RCs are published to nuget.org. Drop the .nupkg files in
    ./artifacts/packages and they resolve locally.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="mpcore-rc" value="./artifacts/packages" />
  </packageSources>

  <!-- The NuGet API key is NEVER stored here. CI uses the NUGET_API_KEY secret. -->
  <packageSourceCredentials />

</configuration>
