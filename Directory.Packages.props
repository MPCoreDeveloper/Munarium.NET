<Project>

  <!--
    Central Package Management: one source of truth for every package version.
    The MPCoreDeveloper net11 RC versions are consumed either from nuget.org (once
    published) or from the local `mpcore-rc` feed declared in NuGet.config.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Static analysis">
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Documents">
    <!--
      A runbook is authored YAML. The reader uses YamlDotNet's representation model and maps
      nodes by hand, exactly as the JSON codecs do, so nothing about a document depends on
      reflection and the mapping stays readable against the original's.
    -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!--
    MPCoreDeveloper stack. The whole SharpCoreDB set ships as net11.0 RC builds at 2.1.0-RC.3, so the
    referencing projects are net11.0-only too (see Directory.Build.props). Versions are the ones
    actually published on nuget.org; the local mpcore-rc feed is only for builds that predate a
    publication.
  -->
  <ItemGroup Label="MPCoreDeveloper stack">
    <PackageVersion Include="SharpCoreDB" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpCoreDB.EventSourcing" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpCoreDB.CQRS" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpCoreDB.VectorSearch" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpCoreDB.Search" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpCoreDB.Graph" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpCoreDB.Graph.Advanced" Version="2.1.0-RC.3" />
    <PackageVersion Include="SharpDispatch" Version="1.1.0-RC.1" />
    <PackageVersion Include="Posseth.UlidFactory" Version="2.1.0-RC.1" />
    <PackageVersion Include="SharpPortico.SourceGenerator" Version="1.1.2-preview.1" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.66.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.66.0" />
  </ItemGroup>

</Project>
