<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Munarium.Server.Tests</RootNamespace>
    <!-- Run xunit.v3 through Microsoft.Testing.Platform via `dotnet test`. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization.Metadata" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Munarium.Server\Munarium.Server.csproj" />
  </ItemGroup>

  <!-- The tests claim under the same shapes a deployment ships. -->
  <ItemGroup>
    <None Include="..\..\shapes\**\*.json"
          Link="shapes\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
