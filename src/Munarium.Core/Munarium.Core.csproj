<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Munarium</RootNamespace>
    <AssemblyName>Munarium.Core</AssemblyName>
    <PackageId>Munarium.Core</PackageId>
    <Description>Munarium pure kernel: the append-only fact ledger, governance gates and context composition, with storage, retrieval and model providers behind interfaces. No HTTP, no provider calls, no database.</Description>
    <PackageTags>munarium;governed-memory;ledger;provenance;rag;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The command path is part of the kernel: governance runs on it, so the dispatcher lives here. -->
    <PackageReference Include="SharpDispatch" />
    <!-- The ledger's identities. A ULID carries the instant it was created at, so the kernel can reason
         about "now" - and about when something was written - without reading a clock, which is what
         keeps a verdict reproducible from the snapshot alone. See LedgerIds and MeshSnapshot.WrittenAt. -->
    <PackageReference Include="Posseth.UlidFactory" />
  </ItemGroup>

</Project>
