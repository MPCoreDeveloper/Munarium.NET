<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Munarium.Wire</RootNamespace>
    <PackageId>Munarium.Wire</PackageId>
    <Description>Munarium's wire contract: the OpenAPI specification is the single source of truth for both the JSON/HTTP surface and the gRPC/protobuf surface generated from it, and both are adapters over one transport-agnostic operation surface.</Description>
    <PackageTags>munarium;wire;grpc;protobuf;openapi;sharpPortico;mmp</PackageTags>
    <!-- The generated service and namespace, read by the generator from the project's MSBuild
         properties: the per-file AdditionalFiles metadata is not surfaced to analyzers by every SDK. -->
    <SharpPorticoServiceName>MunariumService</SharpPorticoServiceName>
    <SharpPorticoNamespace>Munarium.Wire.Generated</SharpPorticoNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Munarium.Core\Munarium.Core.csproj" />
  </ItemGroup>

  <!--
    One specification, two transports. The gRPC/protobuf surface is generated from
    openapi/munarium.v1.yaml by SharpPortico, so the JSON and protobuf surfaces cannot drift on
    operation names, message shapes or enum values.
  -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\openapi\munarium.v1.yaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- A plain package reference: since 0.4.0-RC.1 the package ships the generator under
         analyzers/dotnet/cs, which is the only place NuGet hands an assembly to the compiler as an
         analyzer. Do not also add it with <Analyzer Include=...>, or it runs twice. -->
    <PackageReference Include="SharpPortico.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Net.Client" />
    <!-- Version identities are ULIDs: sortable, spec-compliant, and the same library the rest of the stack uses. -->
    <PackageReference Include="Posseth.UlidFactory" />
  </ItemGroup>

</Project>
