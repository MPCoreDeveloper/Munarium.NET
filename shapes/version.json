{
  "name": "version",
  "version": 1,
  "identity": ["version_id"],
  "schema": {
    "type": "object",
    "required": ["version_id"],
    "additionalProperties": false,
    "properties": {
      "version_id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "parent_version_id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "as_of": { "type": "string", "pattern": "\\A[0-9]{4}-[0-9]{2}-[0-9]{2}\\z" },
      "label": { "type": "string", "maxLength": 200 }
    }
  }
}
