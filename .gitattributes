# Normalize line endings in the repository; check out per platform.
* text=auto

*.cs      text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.slnx    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
.editorconfig text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.snk binary
