# Normalize line endings in the repository; check out per platform.
* text=auto

*.cs      text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.slnx    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
.editorconfig text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.snk binary

# The sibling RC package the local feed carries: a .nupkg is a zip, and the `* text=auto` at the top of this
# file would otherwise put it through the text filter.
*.nupkg binary

# Tooling: the BMad Method skills and runtime are vendored tooling, not product code. They are 461 files
# of Markdown, Python and TOML against roughly 420 source and documentation files, so without these
# marks GitHub's language bar reports the workflow rather than the port. The files stay in the tree.
.agents/**      linguist-vendored
_bmad/**        linguist-vendored
_bmad-output/** linguist-documentation
