<Project>

  <!--
    Munarium.NET - the C# port of Munarium (governed memory and traceable evidence
    for AI applications). Every project in this repository inherits these settings.

    Toolchain: .NET 11 (RC) / C# 15. Storage, retrieval and graph come from the
    MPCoreDeveloper net11 RC packages (SharpCoreDB, SharpDispatch, SharpPortico,
    Posseth.UlidFactory) - see Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <!-- .NET 11 runtime async: async methods compile to runtime-provided async instead of a
         compiler-generated state machine. -->
    <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: .NET analyzers + code style enforced in build; warnings are errors. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible builds -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package metadata (Apache-2.0, same license as the original Munarium).

         The version is split into a prefix and a suffix on purpose. A single Version property would
         make -p:VersionSuffix=rc.1 a no-op - Version wins over VersionSuffix - so a release dispatched
         with a suffix would repack the version already published, and NuGet's skip-duplicate switch
         would then report a release that published nothing. Split, all three paths move: the prefix
         and suffix here give 0.1.0-preview.1 for a local build, -p:VersionSuffix=rc.1 gives
         0.1.0-rc.1, and -p:Version=0.1.0-preview.2 (what a tag passes) still wins over both. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>MPCoreDeveloper</Authors>
    <Company>MPCoreDeveloper</Company>
    <Product>Munarium</Product>
    <Copyright>Copyright (c) 2026 MPCoreDeveloper</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/Munarium.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/Munarium.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- SonarAnalyzer.CSharp: SonarCloud-compatible static analysis, run locally and in CI. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
